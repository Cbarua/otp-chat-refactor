# -----------------------------------------------------------------
# APP CONFIG
# Set to 'development' or 'production'
# In 'development', PHP errors might be shown.
# In 'production', they should be logged.
# -----------------------------------------------------------------
APP_ENV=development

# -----------------------------------------------------------------
# FILE PATHS
# Use absolute paths for best results, especially for cron jobs.
# IMPORTANT: These paths must be OUTSIDE the public web root.
# -----------------------------------------------------------------
APP_LOG_DIR="../logs/app"
CAPI_LOG_DIR="../logs/capi"
ERROR_LOG_PATH="../logs/error.log"
DB_PATH="../logs/userlog.sqlite"

# -----------------------------------------------------------------
# 3RD PARTY API - OTP SERVICE
# -----------------------------------------------------------------
IDEAMART_URLS='["https://example.com/api/ideamart/"]'
MSPACE_URLS='["https://example.com/api/mspace/"]'
BDAPPS_URLS='["https://example.com/api/bdapps/"]'

SMS_NUMBER=77000
SMS_KEYWORD="chat"

# -----------------------------------------------------------------
# 3RD PARTY API - FACEBOOK/META/GOOGLE
# -----------------------------------------------------------------
PIXEL_ID=YOUR_PIXEL_ID
FBCAPI_TOKEN=YOUR_CAPI_ACCESS_TOKEN
TEST_EVENT_CODE=TEST9546

GA_MEASUREMENT_ID=YOUR_GA_MEASUREMENT_ID

# -----------------------------------------------------------------
# CONTENT
# -----------------------------------------------------------------
IMG_URL="assets/images/Girl in a salwar.jpeg"
IMG_ALT="Girl in a salwar"
CHARGE_TEXT="Dialog, Hutch, Airtel & Mobitel Daily Rs 10+tax"
FORM_TITLE="ඔබගේ දුරකතන අංකය පහතින් ඇතුළත් කරන්න"
ICON_PATH="assets/images/icons/two-hearts.png"

# -----------------------------------------------------------------
# URL ROTATION
# -----------------------------------------------------------------
IDEAMART_URLS='["https://example.com/api/success","https://example.com/api/fail1", "https://example.com/api/fail2", "https://example.com/api/success2"]'
MSPACE_URLS='["https://example.com/api/mspace1","https://example.com/api/mspace2"]'
URL_ROTATION_PLATFORMS='["ideamart", "mspace"]'
URL_ROTATION_PRIORITY='{"ideamart": ["success2", "success"], "mspace": ["mspace2"]}'
URL_ROTATION_EXCLUDED_PHONES='["0771234566", "0771234568"]'
URL_ROTATION_EXCLUDED_USERAGENTS='["Bot", "Crawler", "HeadlessChrome"]'
# Set URL_ROTATION_INTERVAL=1 to enable URL rotation on every request
URL_ROTATION_INTERVAL=5