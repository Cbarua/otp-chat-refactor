{
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.23"
        }
    },
    "require": {
        "php": ">=8.4.0",
        "vlucas/phpdotenv": "^5.6",
        "facebook/php-business-sdk": "^23.0",
        "guzzlehttp/guzzle": "^7.10",
        "pimple/pimple": "^3.5",
        "monolog/monolog": "^3.9",
        "nikic/fast-route": "^1.3",
        "symfony/http-foundation": "^7.3",
        "facebook/capi-param-builder-php": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "codeception/codeception": "^5.3",
        "codeception/module-phpbrowser": "^3.0",
        "codeception/module-asserts": "*",
        "mockery/mockery": "^1.6",
        "codeception/module-webdriver": "^4.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:ac": "php scripts/run-acceptance.php",
        "dev:wd": "C:\\webdriver\\msedgedriver.exe --port=10888",
        "dev:wdln": "./webdriver/msedgedriver --port=10888",
        "dev:mockapi": "php -S localhost:8081 ./public/backend-test-api/index.php",
        "dev:frontend": "php -S localhost:8080 -t public",
        "test:acceptance": "vendor/bin/codecept run Acceptance,NoJs",
        "test:unit": "vendor/bin/phpunit --display-all-issues --testdox",
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "vendor/bin/phpunit --display-all-issues --testdox --coverage-html coverage-report"
        ],
        "dev:stwd": "taskkill /IM msedgedriver.exe /F",
        "dev:stwdln": "pkill -f msedgedriver || true",
        "install:production": "composer install --no-dev --optimize-autoloader"
    }
}
